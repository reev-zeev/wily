{
  "name": "wasla-platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "bun --bun tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "dev:gateway": "bun --watch apps/gateway/src/index.ts",
    "dev:workers": "bun --watch apps/workers/src/index.ts",
    "dev:dashboard": "cd apps/admin-dashboard && bun --watch src/index.tsx"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "^1.1.3",
    "@types/node": "^20.14.0",
    "bun": "^1.3.14",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.12.0",
    "@supabase/supabase-js": "^2.45.0",
    "@upstash/ratelimit": "^1.2.0",
    "@upstash/redis": "^1.31.0",
    "grammy": "^1.26.0",
    "hono": "^4.5.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
